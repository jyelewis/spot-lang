use com.spot.http.HttpAuthGuard
use com.spot.logger

// abstract module
implements module HttpAuthGuard

struct JWTAuthGuardConfig {
    implements ConfigProvider

    jwt_secret_key: String
    encryption: JWT::Encryption = JWT::Encryption::HS256,
    getToken: fn(req: HttpRequest) -> String? = fn(req) {
        // TODO: how do we test this function?
        let auth_header = req.get_header("Authorization").notNullOr {
            return Null
        }

        return auth_header.replace("Bearer ", "")
    }
}

fn can_access(request: HttpRequest) -> AuthGuardResult
    let token = try {
        JWTAuthGuardConfig.get().getToken(request)
    } except (error) {
        logger.warn("Request denied: Failed to .getToken() - {error}")
        return AuthGuardResult::Deny
    }

    let token = token.notNullOr {
        logger.warn("Request denied: No JWT token provided")
        return AuthGuardResult::Deny
    }

    let decoded = try {
        Jwt::decode(
            token: token,
            secret_key: JWTAuthGuardConfig.get().secret_key,
            encryption: JWTAuthGuardConfig.get().encryption
        )
    } except (error: JWTError) {
        logger.warn("Request denied: Failed to validate JWT - {error}")
        return AuthGuardResult::Deny
    }

    return AuthGuardResult::Allow
}
