@@ApiController("/auth")

let jwt_secret_key = "ch@nge_m3_1"

let admin_username = "admin";
let admin_password = "password";

struct LoginRequestDTO {
    implements JSONSerializable

    username: String,
    password: String,
}

struct JwtPayload {
    implements JSONSerializable

    username: String,
    is_admin: Bool
}

struct LoginResponseDTO {
    implements JSONSerializable

    token: String,
}

@Post("/login")
@AuthGuard(AllowEveryone)
fn login(@ReqBody body: LoginRequestDTO) -> LoginResponseDTO {
    let auth_valid = body.username == admin_username && body.password == admin_password
    if (!auth_valid) {
        throw HttpInvalidCredentialsException()
    }

    LoginResponseDTO {
        token: JwtAuth::generateToken(JwtPayload {
            username: body.username,
            is_admin: true
        })
    }
}

@Get("/me")
fn me(@JWTAuthPayload() user: JwtPayload) = user

